{
  "scopeName": "source.goduck",
  "name": "Goduck",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#http"
    },
    {
      "include": "#routes"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.goduck",
          "match": "//.*$"
        },
        {
          "name": "comment.block.goduck",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.goduck",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.goduck",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.goduck",
          "match": "\\b(module|server|let|const|import|export|return)\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "storage.type.goduck",
          "match": "\\b(string|number|boolean|any)\\b"
        }
      ]
    },

    "http": {
      "patterns": [
        {
          "name": "keyword.control.http.goduck",
          "match": "\\b(GET|POST|PUT|PATCH|DELETE)\\b"
        }
      ]
    },

    "routes": {
      "patterns": [
        {
          "name": "string.unquoted.route.goduck",
          "match": "\"/[^\"\\n]*\""
        },
        {
          "name": "entity.name.function.goduck",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "variables": {
      "patterns": [
        {
          "name": "keyword.control.declaration.goduck",
          "match": "\\b(let|const)\\b"
        },
        {
          "name": "variable.other.goduck",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*:)"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.goduck",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.goduck",
          "match": "->|=|:"
        }
      ]
    }
  }
}
