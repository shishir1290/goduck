app Hello

server {
    port 8080
}

module Home {

    controller HomeController

    service HomeService

    repository HomeRepository

    GET "/" -> Index

    GET "/about" -> About

}

module User {

    controller UserController

    service UserService

    repository UserRepository

    GET "/users" -> Index

    GET "/users/:id" -> Show

    POST "/users" -> Create

    PUT "/users/:id" -> Update

    PATCH "/users/:id" -> Patch

    DELETE "/users/:id" -> Delete

}